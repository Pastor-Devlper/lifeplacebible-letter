---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "소개";

const ministries = [
  { name: "지부운영국", desc: "국내사역" },
  { name: "SI국", desc: "해외사역" },
  { name: "출판국", desc: "교재, PPT" },
  { name: "다음세대", desc: "KIDS, YRG, 펄" },
  { name: "군사역본부", desc: "군 선교사역" },
  { name: "총무국", desc: "행정지원" },
];
---

<BaseLayout pageTitle={pageTitle} showTitle={false} fullWidth={true}>
  <section class="about-hero">
    <div class="about-hero-inner">
      <span class="about-tag">생터성경사역원</span>
      <h1 class="about-title">막힌 곳을 뚫어주는<br />성경교육기관</h1>
      <div class="about-divider"></div>
    </div>
  </section>

  <section class="about-section">
    <div class="about-content">

      <div class="about-text">
        <p>
          <strong>생터성경사역원</strong>은 누구나 성경을 입체적으로 읽을 수 있도록 돕는
          전문강사를 양성하는 성경교육기관입니다.
        </p>
        <p>
          '어? 성경이 읽어지네' 기반의 교육 과정을 통해 전문강사는
          1단계 성경일독학교, 2단계 인도자 컨퍼런스를 수료한 후,
          마지막 단계인 <strong>전문강사스쿨</strong>(6개월 정규과정)을 거쳐 세워집니다.
        </p>
      </div>

      <div class="ministry-grid">
        {ministries.map((m) => (
          <div class="ministry-card">
            <span class="ministry-name">{m.name}</span>
            <span class="ministry-desc">{m.desc}</span>
          </div>
        ))}
      </div>

      <div class="about-video">
        <iframe
          src="https://www.youtube.com/embed/adsysdKsbeo?si=1MiegiC04E5vlkey"
          title="생터성경사역원 소개"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>

    </div>
  </section>
</BaseLayout>
