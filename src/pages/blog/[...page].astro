---
import type { GetStaticPathsOptions, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPost from "../../components/BlogPost.astro";

type Props = {
  page: Page<CollectionEntry<'blog'>>;
};

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = (await getCollection('blog'))
    .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
  return paginate(allPosts, { pageSize: 9 });
}

const { page } = Astro.props;
const pageTitle = "생터 소식";
---
<BaseLayout pageTitle={pageTitle}>
  <h2>생터에 오신 것을 환영합니다!</h2>
  <p>여기서 생터의 최신 소식을 만나보세요.</p>

  <ul class="posts-grid">
    {page.data.map((post) => (
      <BlogPost
        url={`/posts/${post.id}`}
        title={post.data.title}
        image={post.data.image}
        pubDate={post.data.pubDate}
      />
    ))}
  </ul>

  {page.lastPage > 1 && (
    <nav class="pagination" aria-label="페이지 이동">
      {page.url.prev
        ? <a href={page.url.prev} class="page-btn">← 이전</a>
        : <span class="page-btn disabled">← 이전</span>
      }

      <div class="page-numbers">
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => (
          <a
            href={num === 1 ? '/blog/' : `/blog/${num}`}
            class={`page-num ${num === page.currentPage ? 'active' : ''}`}
          >
            {num}
          </a>
        ))}
      </div>

      {page.url.next
        ? <a href={page.url.next} class="page-btn">다음 →</a>
        : <span class="page-btn disabled">다음 →</span>
      }
    </nav>
  )}
</BaseLayout>

<style>
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 280px));
    gap: 1.5rem;
    padding: 0;
    margin: 2rem 0 0;
    list-style: none;
    justify-content: center;
  }

  @media screen and (max-width: 768px) {
    .posts-grid {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }

    .posts-grid li:nth-child(n+7) {
      display: none;
    }
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 3rem 0 2rem;
  }

  .page-btn {
    padding: 0.5rem 1.2rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: #ffffff;
    background-color: #00539F;
    text-decoration: none;
    border-radius: 2rem;
    transition: background-color 0.2s ease;
  }

  .page-btn:hover {
    background-color: #003d73;
  }

  .page-btn.disabled {
    background-color: #ccc;
    cursor: default;
    pointer-events: none;
  }

  .page-numbers {
    display: flex;
    gap: 0.4rem;
  }

  .page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #00539F;
    text-decoration: none;
    border-radius: 50%;
    border: 2px solid transparent;
    transition: all 0.2s ease;
  }

  .page-num:hover {
    border-color: #00539F;
  }

  .page-num.active {
    background-color: #00539F;
    color: #ffffff;
  }

  p {
    margin: 0.5rem 0;
    font-size: 0.9rem;
    color: #555;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    p {
      font-size: 0.85rem;
    }
  }
</style>
