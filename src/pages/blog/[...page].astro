---
import type { GetStaticPathsOptions, Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogPost from "../../components/BlogPost.astro";
import KakaoListShareButton from "../../components/KakaoListShareButton.astro";

type Props = {
  page: Page<CollectionEntry<'blog'>>;
};

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allPosts = (await getCollection('blog'))
    .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());
  return paginate(allPosts, { pageSize: 9 });
}

const { page } = Astro.props;
const pageTitle = "생터 꿈터";

const allTags = [...new Set(
  page.data.flatMap(post => post.data.tags ?? []).filter(Boolean)
)];

const allPostsForMonths = await getCollection('blog');
const recentMonths = [...new Set(
  allPostsForMonths
    .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
    .map(post => {
      const d = new Date(post.data.pubDate);
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
    })
)].slice(0, 3);

const latestPosts = allPostsForMonths.slice(0, 5).map(post => ({
  id: post.id,
  title: post.data.title,
  pubDate: post.data.pubDate,
  author: post.data.author,
  image: post.data.image,
}));
---

<BaseLayout pageTitle={pageTitle} showTitle={false} fullWidth={true}>
  <section class="blog-hero">
    <div class="blog-hero-inner">
      <span class="blog-tag">생터 꿈터</span>
      <h1 class="blog-title">생터의 소식을<br />전해드립니다</h1>
      <div class="blog-divider"></div>
      <KakaoListShareButton posts={latestPosts} />
    </div>
  </section>

  <section class="blog-section">
    {(recentMonths.length > 0 || allTags.length > 0) && (
      <div class="tag-row">
        {recentMonths.map(month => {
          const [year, mon] = month.split('-');
          return (
            <a href={`/months/${month}`} class="tag-pill tag-pill--month">{year}년 {Number(mon)}월</a>
          );
        })}
        {allTags.map(tag => (
          <a href={`/tags/${tag}`} class="tag-pill">{tag}</a>
        ))}
      </div>
    )}

    <ul class="posts-grid">
      {page.data.map((post) => (
        <BlogPost
          url={`/posts/${post.id}`}
          title={post.data.title}
          image={post.data.image}
          pubDate={post.data.pubDate}
          description={post.data.description}
          tags={post.data.tags}
        />
      ))}
    </ul>

    {page.lastPage > 1 && (
      <nav class="pagination" aria-label="페이지 이동">
        {page.url.prev
          ? <a href={page.url.prev} class="page-btn" aria-label="이전 페이지">&#8249;</a>
          : <span class="page-btn disabled">&#8249;</span>
        }
        {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((num) => (
          <a
            href={num === 1 ? '/blog/' : `/blog/${num}`}
            class={`page-num ${num === page.currentPage ? 'active' : ''}`}
          >
            {num}
          </a>
        ))}
        {page.url.next
          ? <a href={page.url.next} class="page-btn" aria-label="다음 페이지">&#8250;</a>
          : <span class="page-btn disabled">&#8250;</span>
        }
      </nav>
    )}
  </section>
</BaseLayout>

<style>
  /* ── 히어로 ── */
  .blog-hero {
    background-color: #f8f9fa;
    padding: 32px 40px;
    display: flex;
    justify-content: center;
  }

  .blog-hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    max-width: 760px;
    text-align: center;
  }

  .blog-tag {
    display: inline-block;
    background-color: #fff4f0;
    color: #ff9776;
    font-size: 1.25rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 100px;
  }

  .blog-title {
    margin: 0;
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1.3;
    color: #1a1a2e;
    font-family: 'Gowun Dodum', sans-serif;
  }

  .blog-divider {
    width: 40px;
    height: 3px;
    background-color: #ff9776;
    border-radius: 2px;
  }

  /* ── 본문 ── */
  .blog-section {
    background-color: #ffffff;
    padding: 28px 40px 40px;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 36px;
  }

  .tag-pill {
    display: inline-block;
    padding: 5px 14px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #0d0950;
    background-color: #eef0ff;
    border-radius: 100px;
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }

  .tag-pill:hover {
    background-color: #0d0950;
    color: #ffffff;
  }

  .tag-pill--month {
    background-color: #fff4f0;
    color: #ff9776;
    font-weight: 700;
  }

  .tag-pill--month:hover {
    background-color: #ff9776;
    color: #ffffff;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  /* ── 페이지네이션 ── */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    margin-top: 56px;
  }

  .page-btn,
  .page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.15s, color 0.15s;
  }

  .page-btn {
    font-size: 1.25rem;
    color: #9ca3af;
  }

  .page-btn:hover {
    background: #f3f4f6;
    color: #374151;
  }

  .page-btn.disabled {
    color: #d1d5db;
    pointer-events: none;
  }

  .page-num {
    color: #374151;
  }

  .page-num:hover {
    background: #f3f4f6;
  }

  .page-num.active {
    background-color: #0d0950;
    color: #ffffff;
  }

  /* ── 반응형 ── */
  @media screen and (max-width: 1024px) {
    .posts-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 768px) {
    .blog-hero {
      padding: 24px 1rem;
    }

    .blog-title {
      font-size: 1.875rem;
    }

    .blog-section {
      padding: 40px 1.5rem 56px;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
