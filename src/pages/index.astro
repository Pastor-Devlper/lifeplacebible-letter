---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const pageTitle = "생터성경사역원 소식";

const posts = await getCollection('blog');
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 4);
---

<BaseLayout pageTitle={pageTitle} showTitle={false} fullWidth={true}>
  <section class="hero">
    <div class="hero-inner">
      <span class="hero-tag">생터성경사역원</span>
      <h1 class="hero-title">생명의 자리에서<br />말씀을 나눕니다</h1>
      <div class="hero-divider"></div>
      <p class="hero-sub">생터의 뉴스레터, 출판 소식, 행사 이야기를 전해드립니다.</p>
    </div>
  </section>

  <section class="posts-section">
    <div class="section-heading">
      <h2>최신 소식</h2>
      <a href="/blog/" class="more-link">전체 보기 →</a>
    </div>
    <div class="card-grid">
      {recentPosts.map((post) => (
        <a href={`/posts/${post.id}`} class="card">
          <div class="card-image">
            <img src={post.data.image.url} alt={post.data.image.alt} />
          </div>
          <div class="card-body">
            {post.data.tags?.[0] && (
              <span class="card-tag">{post.data.tags[0]}</span>
            )}
            <h3 class="card-title">{post.data.title}</h3>
            <p class="card-desc">{post.data.description}</p>
            <span class="card-date">
              {new Date(post.data.pubDate).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background-color: #f8f9fa;
    padding: 40px 40px;
    display: flex;
    justify-content: center;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 760px;
    text-align: center;
  }

  .hero-tag {
    display: inline-block;
    background-color: #fff4f0;
    color: #ff9776;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 100px;
  }

  .hero-title {
    margin: 0;
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.3;
    color: #1a1a2e;
    font-family: 'Gowun Dodum', sans-serif;
    text-align: center;
  }

  .hero-divider {
    width: 150px;
    height: 2px;
    background-color: #ff9776;
    border-radius: 2px;
  }

  .hero-sub {
    margin: 0;
    font-size: 1.0625rem;
    color: #6b7280;
    line-height: 1.6;
  }

  .posts-section {
    padding: 32px 40px 40px;
    background-color: #ffffff;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
  }

  .section-heading h2 {
    margin: 0;
    font-size: 1.375rem;
    font-weight: 700;
    color: #1a1a2e;
    text-align: left;
  }

  .more-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: #ff9776;
    text-decoration: none;
  }

  .more-link:hover {
    text-decoration: underline;
  }

  .card-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }

  .card {
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 16px -4px rgb(0 0 0 / 0.06);
    transition: box-shadow 0.2s, transform 0.2s;
    display: flex;
    flex-direction: column;
  }

  .card:hover {
    box-shadow: 0 8px 28px -4px rgb(0 0 0 / 0.12);
    transform: translateY(-2px);
  }

  .card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f3f4f6;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    padding: 24px 28px 28px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card-tag {
    display: inline-block;
    background: #eef0ff;
    color: #0d0950;
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 100px;
    width: fit-content;
  }

  .card-title {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.4;
    color: #1a1a2e;
  }

  .card-desc {
    margin: 0;
    font-size: 0.875rem;
    color: #6b7280;
    line-height: 1.6;
  }

  .card-date {
    font-size: 0.75rem;
    color: #9ca3af;
  }

  @media screen and (max-width: 768px) {
    .hero {
      padding: 24px 1rem;
    }

    .hero-title {
      font-size: 2rem;
    }

    .hero-sub {
      word-break: keep-all;
    }

    .posts-section {
      padding: 40px 1.5rem;
    }

    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>