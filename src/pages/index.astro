---
import BaseLayout from "../layouts/BaseLayout.astro";
import Greeting from "../components/Greeting";
import Carousel from "../components/Carousel.astro";
import { getCollection } from "astro:content";

const pageTitle = "생터성경사역원 소식";

// 최근 포스트들의 이미지를 가져옵니다
const posts = await getCollection('blog');
const recentPosts = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime()).slice(0, 5);
const images = recentPosts.map(post => post.data.image.url);
const titles = recentPosts.map(post => post.data.title);
const links = recentPosts.map(post => `/posts/${post.id}`);
---

<BaseLayout pageTitle={pageTitle}>
  <h2>우리는 성경을 가르치는 권서인을 길러냅니다!</h2>
  <div class="home-content">
    <Greeting client:load messages={["안녕하세요^^", "반가워요^^", "좋은 하루^^", "환영해요^^"]} />
    <Carousel images={images} titles={titles} links={links} client:load />
  </div>
</BaseLayout>

<style>
  .home-content {
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

    .greeting-button {
    margin: 1rem 0 2rem 0;
    padding: 0.5rem 1rem;
    font-size: 1rem;
    color: white;
    background-color: #4c1d95;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }
</style>