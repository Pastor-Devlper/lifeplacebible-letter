---
interface Props {
  title: string;
  description?: string;
  imageUrl?: string;
  link?: string;
}
const { title, description = "", imageUrl = "", link } = Astro.props;
const templateId = import.meta.env.PUBLIC_KAKAO_TEMPLATE_ID;
---

{templateId && (
  <button
    type="button"
    class="kakao-share-btn"
    data-title={title}
    data-description={description}
    data-image-url={imageUrl}
    data-link={link ?? ""}
    aria-label="카카오톡으로 공유하기"
    hidden
  >
    <svg class="kakao-share-icon" viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="12" fill="#FEE500" />
      <path
        fill="#3C1E1E"
        d="M12 5.5c-4.14 0-7.5 2.64-7.5 5.9 0 2.1 1.4 3.95 3.5 5l-.72 2.63a.35.35 0 0 0 .53.39l3.05-2.02c.37.04.75.06 1.14.06 4.14 0 7.5-2.64 7.5-5.9s-3.36-6.06-7.5-6.06z"
      />
    </svg>
    카카오톡 공유
  </button>
)}

<script define:vars={{ templateId }}>
  document.querySelectorAll(".kakao-share-btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      if (!window.Kakao || !window.Kakao.isInitialized()) {
        alert("카카오 공유 기능을 사용할 수 없습니다.");
        return;
      }
      window.Kakao.Share.sendCustom({
        templateId: Number(templateId),
        templateArgs: {
          title: btn.dataset.title,
          description: btn.dataset.description,
          image_url: btn.dataset.imageUrl,
          link: btn.dataset.link || window.location.href,
        },
      });
    });
  });

  // 관리자(Netlify Identity 로그인) 상태에서만 버튼을 노출한다.
  (function () {
    function applyVisibility() {
      const user = window.netlifyIdentity && window.netlifyIdentity.currentUser();
      document.querySelectorAll(".kakao-share-btn").forEach((btn) => {
        btn.hidden = !user;
      });
    }
    applyVisibility();
    let tries = 0;
    const timer = setInterval(() => {
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on("init", applyVisibility);
        window.netlifyIdentity.on("login", applyVisibility);
        window.netlifyIdentity.on("logout", applyVisibility);
        applyVisibility();
        clearInterval(timer);
      } else if (++tries > 40) {
        clearInterval(timer);
      }
    }, 250);
  })();
</script>
