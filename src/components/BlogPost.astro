---
const { url, title, image, pubDate, description, tags } = Astro.props;
const date = new Date(pubDate);
const formattedDate = date.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
---
<li>
  <a href={url} class="card">
    <div class="card-image">
      {image?.url
        ? <img src={image.url} alt={image.alt ?? title} />
        : <div class="card-image-placeholder"></div>
      }
    </div>
    <div class="card-body">
      {tags?.[0] && <span class="card-tag">{tags[0]}</span>}
      <h3 class="card-title">{title}</h3>
      {description && <p class="card-desc">{description}</p>}
      <span class="card-date">{formattedDate}</span>
    </div>
  </a>
</li>

<style>
  li {
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 4px 16px -4px rgb(0 0 0 / 0.06);
    transition: box-shadow 0.2s, transform 0.2s;
    height: 100%;
  }

  .card:hover {
    box-shadow: 0 8px 28px -4px rgb(0 0 0 / 0.12);
    transform: translateY(-2px);
  }

  .card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f3f4f6;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .card:hover .card-image img {
    transform: scale(1.03);
  }

  .card-image-placeholder {
    width: 100%;
    height: 100%;
    background: #f3f4f6;
  }

  .card-body {
    padding: 20px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .card-tag {
    display: inline-block;
    background: #eef0ff;
    color: #0d0950;
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 100px;
    width: fit-content;
  }

  .card-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    color: #1a1a2e;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-desc {
    margin: 0;
    font-size: 0.8125rem;
    color: #6b7280;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-date {
    font-size: 0.75rem;
    color: #9ca3af;
    margin-top: auto;
    padding-top: 4px;
  }
</style>
