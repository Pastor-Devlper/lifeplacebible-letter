---
const { url, title, image, pubDate } = Astro.props;
const date = new Date(pubDate);
const formattedDate = `${date.getFullYear()}년 ${date.getMonth() + 1}월`;
---
<li>
  <a href={url} class="post-card">
    <div class="post-card-image">
      {image?.url ? <img src={image.url} alt={image.alt ?? title} /> : null}
    </div>
    <div class="post-card-body">
      <p class="post-title">
        <em class="post-date">{formattedDate}</em>{title}
      </p>
    </div>
  </a>
</li>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .post-card-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: #e2e8f0;
    border-radius: 8px;
  }

  .post-card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .post-card:hover .post-card-image img {
    transform: scale(1.03);
  }

  .post-card-body {
    padding: 0.65rem 0.1rem 0.5rem;
  }

  .post-title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.6;
    color: #1a1a1a;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-date {
    font-style: normal;
    font-weight: 500;
    color: #0064b0;
    margin-right: 0.35rem;
  }
</style>
