---
import Navigation from "./navigation.astro"
import Menu from "./Menu.astro"
import ThemeIcon from "./ThemeIcon.astro"
---
<header>
    <nav>
        <ThemeIcon />
        <div>
            <Navigation />
            <Menu />
        </div>
    </nav>
</header>

<style>
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
  }
  div {
    display: flex;
    align-items: center;
  }
</style>